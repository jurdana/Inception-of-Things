# Ruby standard libraries used to generate and store the shared K3s token
require "securerandom"   # cryptographically secure random generator
require "fileutils"      # filesystem helpers (mkdir -p equivalent)

# --- Box ---------------------------------------------------------------------
# Local name under which Vagrant caches the box (~/.vagrant.d/boxes/fedora44)
BOX_NAME = "fedora44"
# Official Fedora 44 Cloud Base VirtualBox box, published on the Fedora mirror itself
# (not on the HashiCorp registry). Check for a newer release before each defense.
BOX_URL  = "https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Vagrant-VirtualBox-44-1.7.x86_64.vagrant.virtualbox.box"

# --- Machines ----------------------------------------------------------------
# Names imposed by the subject: <login>S for the server, <login>SW for the worker
SERVER_NAME = "pjurdanaS"
SERVER_IP   = "192.168.56.110"   # IP imposed by the subject for the server
WORKER_NAME = "pjurdanaSW"
WORKER_IP   = "192.168.56.111"   # IP imposed by the subject for the worker

HOST_GATEWAY = "192.168.56.1"   # host side of the private network (routes VMs to the internet)

# --- Shared K3s token --------------------------------------------------------
# K3s agents need a secret token to join the server. Instead of reading it from
# the server after install (which required an extra Makefile step), we generate
# it here and give the same value to both machines.
# Path of the file holding the token, inside p1/.vagrant (deleted by p1-clean)
token_file = File.join(__dir__, ".vagrant", "k3s_token")
# Make sure p1/.vagrant exists (it does not on the very first run)
FileUtils.mkdir_p(File.dirname(token_file))
# Generate a 64-char hex token only if none exists yet, so that every vagrant
# command (up, provision, ssh...) reuses the same token for the same cluster
File.write(token_file, SecureRandom.hex(32)) unless File.exist?(token_file)
# Load the token (strip removes a possible trailing newline)
K3S_TOKEN = File.read(token_file).strip

# --- K3s cache ---------------------------------------------------------------
# K3s binary, installer and airgap images pre-downloaded on the host (optional)
K3S_CACHE = File.expand_path("~/.cache/iot/k3s")

# Vagrant configuration, format version 2 (current format)
Vagrant.configure("2") do |config|
  # --- Settings shared by both machines ---
  config.vm.box              = BOX_NAME   # box to use
  config.vm.box_url          = BOX_URL    # where to download it if not cached
  config.vm.box_check_update = false      # no update check on each `vagrant up`
  # Disable the /vagrant shared folder: scripts are uploaded by the provisioner
  # (path: ...), so sharing is not needed and avoids guest additions issues
  config.vm.synced_folder ".", "/vagrant", disabled: true
  # Upload the K3s cache to each VM (runs before the machine provisioners).
  # Without it, the scripts fall back to downloading K3s from the internet.
  if File.exist?(File.join(K3S_CACHE, "k3s"))
    config.vm.provision "file", source: K3S_CACHE, destination: "/tmp/k3s-cache"
  end

  # VirtualBox settings applied to both machines
  config.vm.provider "virtualbox" do |vb|
    # The subject recommends 1 CPU / 512-1024 MB, but under nested virtualization
    # 1 vCPU starves kubelet (node flaps NotReady) and the K3s server needs
    # 2 CPU / 2 GB (K3s documented server minimum)
    vb.cpus         = 2
    vb.memory       = 2048   # MB
    vb.linked_clone = true   # VMs share the box disk instead of a full copy
    # The Fedora box ships with the "Legacy" paravirt provider (= none): the
    # guest kernel then runs as on bare metal (no PV spinlocks, IPIs, TLB flush)
    # and every such operation traps to the hypervisor, which is very costly
    # under nested virtualization. KVM is the native interface of the Linux kernel.
    vb.customize ["modifyvm", :id, "--paravirt-provider", "kvm"]
  end

  # --- Server: K3s controller ---
  config.vm.define SERVER_NAME do |server|
    server.vm.hostname = SERVER_NAME   # hostname inside the VM
    # Dedicated host-only interface with the fixed IP required by the subject
    server.vm.network "private_network", ip: SERVER_IP
    server.vm.provider "virtualbox" do |vb|
      vb.name = SERVER_NAME   # VM name in VirtualBox (modern equivalent of
                              # v.customize ["modifyvm", :id, "--name", ...])
    end
    # Run scripts/server.sh as root on first `vagrant up`,
    # with these environment variables available inside the script
    server.vm.provision "shell", path: "scripts/server.sh",
      env: { "NODE_IP" => SERVER_IP, "GATEWAY" => HOST_GATEWAY, "K3S_TOKEN" => K3S_TOKEN }
  end

  # --- Worker: K3s agent ---
  # Defined after the server: with VirtualBox, Vagrant brings machines up one
  # after the other, so the server is installed before the agent tries to join
  config.vm.define WORKER_NAME do |worker|
    worker.vm.hostname = WORKER_NAME
    worker.vm.network "private_network", ip: WORKER_IP
    worker.vm.provider "virtualbox" do |vb|
      vb.name = WORKER_NAME
    end
    # The agent also needs the server IP to know which API to join
    worker.vm.provision "shell", path: "scripts/agent.sh",
      env: { "NODE_IP" => WORKER_IP, "SERVER_IP" => SERVER_IP, "GATEWAY" => HOST_GATEWAY, "K3S_TOKEN" => K3S_TOKEN }
  end
end